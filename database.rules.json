{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "devices": {
      ".indexOn": ["Identity/auth_uid"],
      "$agentId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "device": {
          "live": {
            ".validate": "newData.hasChildren(['updated_at']) || newData.hasChildren(['t']) || newData.hasChildren(['latitude'])"
          }
        },
        "Identity": {
          "lineage": {
            ".validate": "newData.hasChildren(['path', 'root_id']) || true"
          }
        }
      }
    },
    "History": {
      "$agentId": {
        "history": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [".key", "timestamp", "t"]
        }
      }
    },
    "History_Archive": {
      "$agentId": {
        "history": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [".key", "timestamp", "t"]
        }
      }
    },
    "Geofencing": {
      "$creatorId": {
        "safe_zones": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "lookup_indices": {
      ".read": "auth != null",
      ".write": "auth != null",
      "auth_to_device": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hw_mapping": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pairing_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["parentDeviceId", "invite_code", "pairCode", "creator_device_id", "status"]
    },
    "relationships": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "locations": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["geohash", "timestamp"]
    },
    "Version_Update": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
