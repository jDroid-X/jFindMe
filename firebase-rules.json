{
  "rules": {
    "locations": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && $userId == auth.uid",
        "batteryLevel": {
          ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 100"
        },
        "timestamp": {
          ".validate": "newData.val() <= now + 300000"
        },
        "isPoked": {
          ".write": "auth != null"
        },
        "pokedBy": {
          ".write": "auth != null"
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && $userId == auth.uid"
      }
    },
    "geofences": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
