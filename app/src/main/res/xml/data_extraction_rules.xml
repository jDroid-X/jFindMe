<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local transient SQLite database and registry to guarantee clean identity negotiation on reinstall -->
        <exclude domain="database" path="DatabaseHelper.db" />
        <exclude domain="database" path="DatabaseHelper.db-journal" />
        <exclude domain="database" path="DatabaseHelper.db-wal" />
        <exclude domain="database" path="DatabaseHelper.db-shm" />
        <exclude domain="sharedpref" path="system_registry.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="DatabaseHelper.db" />
        <exclude domain="database" path="DatabaseHelper.db-journal" />
        <exclude domain="database" path="DatabaseHelper.db-wal" />
        <exclude domain="database" path="DatabaseHelper.db-shm" />
        <exclude domain="sharedpref" path="system_registry.xml" />
    </device-transfer>
</data-extraction-rules>