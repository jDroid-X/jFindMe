<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- QA Missing UI Overlay: Required to navigate to Profile Screen and trigger Avatar Scans -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@android:drawable/btn_default"
            android:contentDescription="Open Profile and Avatar Settings"
            android:focusable="true"
            android:nextFocusForward="@+id/btnRadar" />

        <ImageButton
            android:id="@+id/btnRadar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@android:drawable/btn_default"
            android:contentDescription="Scan Map For Nearby 3D Avatars"
            android:focusable="true"
            android:nextFocusForward="@+id/btnInventory" />

        <ImageButton
            android:id="@+id/btnInventory"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:background="@android:drawable/btn_default"
            android:contentDescription="Open Avatar Accessories"
            android:focusable="true" 
            android:nextFocusForward="@+id/btnProfile" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
