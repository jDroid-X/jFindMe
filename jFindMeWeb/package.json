{
  "name": "jfindme-web",
  "version": "3.1.0",
  "description": "jButterfly GPS Telemetry Web Dashboard",
  "main": "js/server.js",
  "scripts": {
    "start": "node js/server.js",
    "dev": "node js/server.js",
    "test": "node scripts/check_syntax.js && node scripts/lint_hardcoded_devices.js && node scripts/deployment/run-integration-tests.js",
    "check:syntax": "node scripts/check_syntax.js",
    "lint:ssot": "node scripts/lint_hardcoded_devices.js",
