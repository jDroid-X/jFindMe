<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Light & Dark auto-adaptive NoActionBar -->
    <style name="Theme.JButterFly" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_butterfly</item>
        <item name="colorPrimaryVariant">@color/brand_butterfly_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/purple_700</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar and background -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>