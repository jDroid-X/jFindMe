    <string name="notif_settings_set_the_fallback_average_speed">Set the fallback average speed used to calculate real-time estimated travel time (ETA) when a device is stationary or walking.\n\nRelative to rendezvous distance, dynamically adjusts predicted arrival times.</string>
    <string name="notif_settings_set_the_maximum_number_of">Set the maximum number of days a Butterfly Meeting Point remains active/available before automated archival and cloud purge.\n\nExchange of tracking telemetry and vectors only occurs during this window.</string>
    <string name="notif_settings_set_the_proximity_radius_around">Set the proximity radius around the Butterfly Point within which tactical high-velocity vector tracking and live spiderweb lines activate.\n\nOptimizes cellular bandwidth and battery life outside this boundary.</string>
    <string name="notif_settings_set_the_time_to_rendezvous">Set the Time-to-Rendezvous (TTR) window before the scheduled meeting when active approach monitoring begins.\n\nPrior to this window, devices remain in low-cost deep hibernation with zero redundant cloud updates.</string>
    <string name="notif_settings_sets_the_baseline_perimeter_radius">Sets the baseline perimeter radius (in meters) automatically assigned when creating new safe zones or missions.</string>
    <string name="notif_settings_sets_the_duration_in_seconds">Sets the duration (in seconds) the application waits for a remote target device to wake its GNSS co-processor and return a fresh GPS fix before falling back to cached telemetry.</string>
    <string name="notif_settings_sets_the_physical_pixel_radius">Sets the physical pixel radius used to fan out overlapping avatar markers when multiple devices are co-located in the same building or safe zone.</string>
    <string name="notif_settings_sets_the_proximity_distance_threshold">Sets the proximity distance threshold (in meters). Devices beyond this radius are highlighted in sky blue in the Tactical Radar scanner.</string>
    <string name="notif_settings_time_remaining_after_tap_until">Time remaining after tap until broadcast begins. During this window, user can CANCEL the trigger.</string>
