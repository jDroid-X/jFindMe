<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">
        
        <!-- Header Zone -->
        <LinearLayout
            android:id="@+id/top_hero_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <!-- Left: Menu & User Badge (Symmetrical 1.0f) -->
            <LinearLayout
                android:id="@+id/badge_card"
                android:layout_width="0dp"
                android:layout_weight="1.0"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="3dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                
                <ImageView
                    android:id="@+id/menu_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_main_menu"
                    android:contentDescription="Open Navigation Drawer"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/expand_icon"
                    android:nextFocusRight="@+id/expand_icon"
                    android:nextFocusForward="@+id/expand_icon" />
                    
                <ImageView
                    android:id="@+id/header_avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="6dp" />
                    
                <TextView
                    android:id="@+id/tv_nick_name"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="2dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
            
            <!-- Center: Fluttering Butterfly Hero -->
            <LinearLayout
                android:id="@+id/active_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Launch Picture-in-Picture Mode"
                android:clipChildren="false"
                android:clipToPadding="false">
                
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:lottie_rawRes="@raw/butterfly_angel"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />
            </LinearLayout>
            
            <!-- Right: Telemetry & Flipper Card (Symmetrical 1.0f) -->
            <LinearLayout
                android:id="@+id/flipper_card"
                android:layout_width="0dp"
                android:layout_weight="1.0"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:layout_marginStart="3dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                
                <ViewFlipper
                    android:id="@+id/header_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:flipInterval="4000"
                    android:autoStart="true"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    
                    <LinearLayout
                        android:id="@+id/status_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end|center_vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">
                        
                        <TextView
                            android:id="@+id/tv_loc_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ME | INITIALIZING..."
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:maxLines="1"
                            android:ellipsize="end" />
                            
                        <TextView
                            android:id="@+id/tv_battery_per"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYNCING | --% 🔋"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </ViewFlipper>
            </LinearLayout>
            
        </LinearLayout>

        <!-- Map Zone Container -->
        <LinearLayout
            android:id="@+id/map_card_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/top_hero_zone"
            app:layout_constraintBottom_toTopOf="@id/dashboard_grid_zone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">
            
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                
                <FrameLayout
                    android:id="@+id/map_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                    
                <ScrollView
                    android:id="@+id/floating_device_scroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="56dp"
                    android:elevation="40dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:scrollbars="none">
                    
                    <LinearLayout
                        android:id="@+id/floating_device_panel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </ScrollView>

                <LinearLayout
                    android:id="@+id/side_action_panel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:elevation="40dp"
                    android:visibility="gone">
                </LinearLayout>
                
                <ImageView
                    android:id="@+id/expand_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:padding="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/menu_icon"
                    android:nextFocusLeft="@+id/menu_icon"
                    android:nextFocusForward="@+id/menu_icon" />

                <!-- Circular (X) Close Button for PiP / Fullscreen Mode -->
                <ImageView
                    android:id="@+id/btn_pip_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Close PiP Window"
                    android:visibility="gone"
                    android:focusable="true"
                    android:clickable="true" />
            </FrameLayout>

            <com.jdroidx.jfindme.ui.base.MarqueeTextView
                android:id="@+id/tv_address_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="🛰️ Satellite standby • Awaiting location • GPS active • • •        "
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Dashboard Grid Zone -->
        <LinearLayout
            android:id="@+id/dashboard_grid_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_zone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
        </LinearLayout>

        <!-- Bottom Nav Zone -->
        <LinearLayout
            android:id="@+id/bottom_nav_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer Content -->
    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical">
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
